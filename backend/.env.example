MONGO_KEY=your_mongodb_connection_string
SECRET_CODE=your_jwt_secret

# Frontend URL where users should land after OAuth success/failure
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: if omitted, backend uses FRONTEND_URL in local dev and request host in production
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Optional: if omitted, backend uses FRONTEND_URL in local dev and request host in production
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
